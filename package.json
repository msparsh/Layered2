{
    "name": "notebook",
    "version": "1.0.0",
    "description": "Minimal Interactive Notebook",
    "main": "main_electron.js",
    "scripts": {
        "dev": "vite",
        "build:vite": "vite build",
        "start": "npm run build:vite && electron .",
        "build": "npm run build:vite && electron-builder"
    },
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "electron": "^41.2.0",
        "electron-builder": "^26.8.1",
        "electron-icon-builder": "^2.0.1",
        "svelte": "^5.55.7",
        "svelte-check": "^4.4.8",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vite": "^8.0.13"
    },
    "build": {
        "appId": "com.notebook.app",
        "productName": "Notebook",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "main_electron.js",
            "preload.js"
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icons/win/icon.ico"
        }
    },
    "dependencies": {
        "@milkdown/crepe": "^7.21.2",
        "@neodrag/svelte": "^2.3.3",
        "electron-context-menu": "^4.1.2",
        "lodash-es": "^4.18.1",
        "write-file-atomic": "^7.0.1"
    }
}
